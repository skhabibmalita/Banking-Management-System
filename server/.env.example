# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- Database ----
# Local replica set from docker-compose.yml (MongoDB transactions need a replica set):
MONGODB_URI=mongodb://127.0.0.1:27017/bank?replicaSet=rs0&directConnection=true
# MongoDB Atlas instead (a free M0 cluster works):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/bank?retryWrites=true&w=majority

# ---- Web app origin(s) allowed to call the API (comma-separated) ----
CLIENT_URL=http://localhost:5173

# ---- Secrets: REQUIRED, 32+ characters, and the two must be DIFFERENT ----
# Generate each with:
#   node -e 'console.log(require("crypto").randomBytes(48).toString("hex"))'
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ---- Sessions ----
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
# Cookies are Secure (HTTPS only) in production and not in development. Override only if you must:
# COOKIE_SECURE=true

# ---- KYC uploads (private folder, never served statically) ----
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ---- Optional helpers ----
# Password for `npm run admin:create` (12+ characters). If unset, a random one is printed once.
# ADMIN_PASSWORD=
# `npm run seed` refuses non-local databases unless this is true:
# SEED_ALLOW_REMOTE=true
