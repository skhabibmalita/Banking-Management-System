{
  "info": {
    "name": "Northwind Bank API",
    "description": "Every endpoint of the Smart Banking System. Start the API (npm run dev), run `npm run seed`, then sign in from folder 1 or 5. Cookies and CSRF headers are handled for you. See docs/API.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "accountId",
      "value": ""
    },
    {
      "key": "toAccountNumber",
      "value": ""
    },
    {
      "key": "txnId",
      "value": ""
    },
    {
      "key": "adminAccountId",
      "value": ""
    },
    {
      "key": "kycDocId",
      "value": ""
    },
    {
      "key": "fraudId",
      "value": ""
    },
    {
      "key": "adminId",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Copy the right CSRF cookie into X-CSRF-Token for state-changing requests.",
          "const method = pm.request.method;",
          "if (['POST','PUT','PATCH','DELETE'].includes(method)) {",
          "  const isAdmin = pm.request.url.getPath().includes('/admin/');",
          "  const value = pm.cookies.get(isAdmin ? 'bank_admin_csrf' : 'bank_csrf');",
          "  if (value) pm.request.headers.upsert({ key: 'X-CSRF-Token', value });",
          "}"
        ]
      }
    }
  ],
